MM_URL=https://gap.bk1.basalam.dev
# Your Gap login token: DevTools > Application > Cookies > MMAUTHTOKEN
MM_TOKEN=
# Private channel the bridge listens on (find its id via the channel's Integrations page)
CHANNEL_ID=
# Incoming webhook URL for the channel above (Integrations > Incoming Webhooks)
WEBHOOK_URL=
CLAUDE_MODEL=opus
CLAUDE_BIN=C:\Users\M.H.Rashadi\.local\bin\claude.exe
# Telegram bot (@BotFather token) and the only Telegram user id it serves (yours — @userinfobot shows it)
TG_BOT_TOKEN=
TG_OWNER_ID=
# Private forum group (Topics on, bot admin with Manage Topics); empty = everything goes to the bot DM
TG_GROUP_ID=
# Existing topic ids (key:thread id), e.g. chat:3,study:6,system:9,reports:13,guests:20; missing ones are created
TG_TOPICS=
# Cloudflare Worker front door (worker/); random hex shared secrets
WORKER_URL=https://pesarkhaleh.mh9rashady.workers.dev
LAPTOP_SECRET=
TG_WEBHOOK_SECRET=
# Only for the Worker's lite mode (pushed with worker/push-secrets.mjs)
ANTHROPIC_API_KEY=

# Eyvan (eyvan.app) personal API token, for eyvan.mjs (colleague directory, read-only)
EYVAN_TOKEN=

# Voice → text (transcribe.py): optional Groq key = whisper-large-v3-turbo API (fast, best); without it the
# local faster-whisper large-v3-turbo on CPU is used (free/offline). V2T_MODEL / V2T_LANG override defaults.
GROQ_API_KEY=
V2T_MODEL=
V2T_LANG=fa
